# API Configuration
BASE_URL=https://api.taskpost.com/v1
API_TIMEOUT=30000

# Payment Gateway
RAZORPAY_KEY=rzp_test_YOUR_KEY_HERE

# App Configuration
APP_NAME=Marketing Pro
APP_VERSION=1.0.0

# Feature Flags
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_RATING=true

# Support
SUPPORT_EMAIL=support@taskpost.com
SUPPORT_PHONE=+91-XXXXXXXXXX

# Environment
ENVIRONMENT=development
