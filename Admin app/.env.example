# Environment Configuration
# Copy this file to .env and update the values

# API Configuration
API_BASE_URL=http://localhost:3000
API_PREFIX=/api/v1

# For Android Emulator (localhost)
# API_BASE_URL=http://10.0.2.2:3000

# For Physical Device on same network
# API_BASE_URL=http://192.168.1.x:3000

# For Production
# API_BASE_URL=https://api.earnpost.com

# App Configuration
APP_NAME=EarnPost Admin
APP_VERSION=1.0.0

# Debug Settings
DEBUG_MODE=true
LOG_LEVEL=debug
